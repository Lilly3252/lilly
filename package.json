		"@types/ms": "^0.7.34",
		"@types/node": "^22.5.4",
		"@typescript-eslint/eslint-plugin": "^8.4.0",
		"@typescript-eslint/parser": "^8.4.0",
		"@yuudachi/framework": "^0.3.5",
		"discord.js": "^14.19.3",
		"eslint": "^9.26.0",
		"i18next": "^25.0.2",
		"libsodium-wrappers": "^0.7.15",
		"mongoose": "^8.14.1",
		"prettier": "^3.3.3",
